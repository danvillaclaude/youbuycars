# Supabase — the YouBuyCars project (NOT the iSellCars one).
# Both values are the PUBLIC pair; the database's RLS does the guarding
# (the anon key can insert an inquiry and read nothing — migration 0002).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The CRM bridge: inquiries forward into the iSellCars inbox (best-effort;
# the Supabase row above is the durable record either way).
# URL is the CRM's /api/public/inquiry; secret matches the CRM's
# INTERNAL_API_SECRET env var.
CRM_INQUIRY_URL=
CRM_INQUIRY_SECRET=
